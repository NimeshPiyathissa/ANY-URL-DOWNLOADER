# ==========================================
# Telegram API Credentials
# Get your API_ID and API_HASH from https://my.telegram.org
# ==========================================
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# ==========================================
# Telegram Bot Token
# Obtain from @BotFather on Telegram
# ==========================================
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# ==========================================
# Telegram Premium User Session String (Optional)
# Unlocks 4GB hybrid uploads using an account with Telegram Premium.
# Generate a session string using any Pyrofork/Pyrogram session generator,
# then paste it here. Leave empty for standard 2GB bot mode.
# ==========================================
USER_SESSION_STRING=

# ==========================================
# Dump Channel / Relay Chat ID (Optional)
# A private channel or group ID where BOTH the bot and the Premium account are admins.
# Used to securely stage and relay 2GB–4GB uploads before delivering to the user.
# Example: DUMP_CHAT_ID=-1001234567890
# ==========================================
DUMP_CHAT_ID=

# ==========================================
# Access Control (Security)
# Comma-separated Telegram User IDs permitted to use the bot.
# Both ALLOWED_USERS and AUTHORIZED_USERS are supported.
# Automatically includes your Bot ID when configured with install.sh.
# Leave empty to allow all users (public mode).
# Example: ALLOWED_USERS=123456789,987654321
# ==========================================
ALLOWED_USERS=
AUTHORIZED_USERS=

# ==========================================
# Concurrency & Performance Settings
# ==========================================
# Maximum simultaneous downloads (prevents server CPU/bandwidth exhaustion)
MAX_CONCURRENT_DOWNLOADS=3

# Progress update throttling interval in seconds (prevents Telegram FloodWait)
# Recommended value: 3.5 to 5.0 seconds
PROGRESS_UPDATE_INTERVAL=3.5

# Directory for storing in-progress and temporary downloads
DOWNLOAD_DIR=downloads
